# Environment Configuration Example
# Copy this file to .env and set your local credentials.

PI_ENVIRONMENT=development
PI_LOG_LEVEL=INFO

# Azure OpenAI / LLM Credentials (Do not commit real keys!)
PI_AZURE_AI_ENDPOINT=https://YOUR-AZURE-ENDPOINT.openai.azure.com/
PI_AZURE_AI_API_KEY=YOUR_AZURE_OPENAI_API_KEY_HERE
PI_AZURE_OPENAI_DEPLOYMENT=gpt-4o
PI_AZURE_AI_API_VERSION=2024-08-01-preview

# Local Persistence Paths
PI_DUCKDB_PATH=data/world_model.duckdb
PI_KUZU_PATH=data/world_model.kuzu
